# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RESEND_API_KEY: Required for real transactional email delivery to user Gmail / Email (Resend.com)
RESEND_API_KEY=MY_RESEND_API_KEY

# TWILIO: Cloud communication platform for real-world SMS / OTP delivery
TWILIO_ACCOUNT_SID=DEFAULT_TWILIO_SID
TWILIO_AUTH_TOKEN=DEFAULT_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=DEFAULT_TWILIO_PHONE
